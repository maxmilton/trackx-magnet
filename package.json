    "zip": "./zip.sh"
  },
  "dependencies": {
    "trackx": "0.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.3",
    "@eslint/js": "9.32.0",
    "@maxmilton/eslint-config": "0.2.1",
    "@maxmilton/test-utils": "0.0.12",
    "@playwright/test": "1.54.2",
    "@swc/core": "1.13.3",
    "@types/bun": "1.2.19",
    "@types/chrome": "0.1.1",
    "eslint": "9.32.0",
    "eslint-plugin-unicorn": "60.0.0",
    "happy-dom": "18.0.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.38.0"
  }
